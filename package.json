{
  "name": "pitbull-fit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "dev": "vite",
    "build": "npx tailwindcss -i ./src/index.css -o ./src/compiled.css && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "start": "npx tailwindcss -i ./src/index.css -o ./src/compiled.css && expo start",
    "android": "npx tailwindcss -i ./src/index.css -o ./src/compiled.css && expo start --android",
    "ios": "npx tailwindcss -i ./src/index.css -o ./src/compiled.css && expo start --ios",
    "web": "npx tailwindcss -i ./src/index.css -o ./src/compiled.css && expo start --web",
    "export:web": "npx tailwindcss -i ./src/index.css -o ./src/compiled.css && expo export -p web",
    "cap:sync": "cap sync",
    "cap:build": "npm run build && cap sync"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "expo": "^58.0.26",
    "expo-constants": "~58.0.16",
    "expo-status-bar": "^58.0.5",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "^0.88.1",
    "react-native-web": "^0.21.4",
    "react-native-webview": "^14.0.1"
  },
  "devDependencies": {
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
